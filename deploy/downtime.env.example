# downtime.env.example — environment variables for production
# Copy to /etc/downtime.env (owner root:deploy, mode 640) and fill in real values.
# Generate a secret key with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"

# Django secret key (50+ random characters, keep secret!)
DJANGO_SECRET_KEY=replace-me-with-a-long-random-value

# Comma-separated hostnames the site will serve (no scheme, no port)
DJANGO_ALLOWED_HOSTS=app.downtimemarket.com

# Absolute path to the SQLite database file (directory must be writable by the `deploy` user)
DATABASE_PATH=/var/lib/downtime/db.sqlite3

# Trust X-Forwarded-For header from Caddy for rate-limiting client IPs (1 = yes)
RATELIMIT_TRUST_XFF=1

# IANA time zone name for the application
TIME_ZONE=UTC

# DJANGO_DEBUG is intentionally omitted — leave unset so DEBUG=off in production.
# If you must enable it temporarily: DJANGO_DEBUG=1