# Caddyfile for Downtime Market
# Caddy's user (typically `caddy` or `www-data`) needs:
#   - read access to /srv/app/staticfiles
#   - execute access on /srv/app (to traverse into staticfiles)
# Install: sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#          caddy validate --config /etc/caddy/Caddyfile
#          sudo systemctl reload caddy

app.downtimemarket.com {
    encode zstd gzip

    handle_path /static/* {
        root * /srv/app/staticfiles
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    handle {
        reverse_proxy 127.0.0.1:8000
    }
}